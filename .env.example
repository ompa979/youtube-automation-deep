# ─── Cloudflare ───────────────────────────────────────────────────────────────
# Set these via `wrangler secret put` for production.
# For local dev, put them here and Wrangler will pick them up.

# ─── LLM (script generation) ──────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=

# Optional high-quality Hindi neural TTS
# Put the Google service-account JSON here for local runs.
EDGE_TTS_VOICE=hi-IN-SwaraNeural

# ─── Visuals ──────────────────────────────────────────────────────────────────
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ─── YouTube upload (rotating projects) ───────────────────────────────────────
# Each value is a base64-encoded OAuth token JSON *with* refresh token.
# Generate with: python scripts/setup_oauth.py
YT_CREDS_1=
YT_CREDS_2=
YT_CREDS_3=
YT_CREDS_4=
YT_CREDS_5=
YT_CREDS_6=
# Free TTS settings
TTS_PROVIDER=edge
TTS_LANGUAGE=hi-IN
TTS_VOICE=hi-IN-MadhurNeural,hi-IN-SwaraNeural
TTS_NO_FALLBACK=false
